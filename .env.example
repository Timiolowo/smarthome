# ==============================================================================
# SmartHome Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your keys: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM PROVIDER API KEYS
# ------------------------------------------------------------------------------
# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Groq Cloud (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Custom OpenAI-compatible endpoint (Ollama, LM Studio, vLLM)
CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
CUSTOM_LLM_API_KEY=

# ------------------------------------------------------------------------------
# 2. ACTIVE LLM ENGINE CONFIGURATION
# Options: gemini | openai | groq | deepseek | local | custom
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 3. HOME & HARDWARE CONFIGURATION
# ------------------------------------------------------------------------------
USER_NAME=Timilehin
ASSISTANT_NAME=Nova
PHONE_IP=192.168.1.150

# Web Dashboard Port
WEB_PORT=5050
HOST=0.0.0.0
